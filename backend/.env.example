# Supabase project URL (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key — safe to also ship to the frontend, used server-side here
# to build the RLS-scoped client bound to each request's JWT.
SUPABASE_ANON_KEY=your-anon-key

# SERVICE ROLE KEY — bypasses RLS. Server-side ONLY. Never send to the
# frontend, never commit this file with a real value, never log it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of allowed frontend origins for CORS.
# Add the deployed Student portal origin(s) here.
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Phase 1: Resume pipeline (all optional — sensible defaults in app/config.py) ---

# Must match the bucket id created by supabase/05_ai_schema.sql.
SUPABASE_STORAGE_BUCKET=student-documents

# Max upload size in bytes. Keep in sync with the bucket's file_size_limit
# in supabase/05_ai_schema.sql if you change this.
RESUME_MAX_FILE_SIZE_BYTES=10485760

# Defensive cap on extracted resume text length (characters).
MAX_EXTRACTED_TEXT_CHARS=200000

# How long a resume's signed download URL stays valid, in seconds.
RESUME_SIGNED_URL_EXPIRY_SECONDS=3600

# --- Phase 2: AI skill extraction + embeddings (all optional except the API key) ---

# Which AI provider implementation to use. Currently supported: gemini.
AI_PROVIDER=gemini

# Gemini API key. Server-side ONLY — never sent to the frontend, never
# committed with a real value. Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini models used for skill extraction and embeddings respectively.
GEMINI_SKILL_EXTRACTION_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# MUST match the vector(N) dimension in supabase/07_ai_embeddings.sql.
# 768 is correct for Gemini's text-embedding-004. Changing the embedding
# model/provider to one with a different output size requires updating
# BOTH this value and the SQL column together.
EMBEDDING_DIMENSIONS=768

# Skill normalization tuning.
SKILL_FUZZY_MATCH_THRESHOLD=88
SKILL_MIN_NORMALIZATION_CONFIDENCE=0.6

# Conservative default proficiency assigned to AI-matched skills (see
# app/services/skill_normalization_service.py for how existing/verified
# skills are protected from this).
AI_SKILL_DEFAULT_PROFICIENCY_SCORE=25.0
AI_SKILL_DEFAULT_PROFICIENCY_LABEL=beginner
